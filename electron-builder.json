{
 "appId": "com.yhm.bili",
 "productName": "BiliDownload",

  "directories": {
    "output": "release",
    "buildResources": "build"
  },

 "files": [
    "dist-electron",
    "dist-react",
    "node_modules/ffmpeg-static/**/*"
],
  "asarUnpack": [
    "node_modules/ffmpeg-static/**"
  ],
 "icon": "./desktopIcon.png",
 "extraResources": [
    "dist-electron/preload.cjs",
    "src/assets/**",
    {
      "from": "src/ui/assets/icon.ico",
      "to": "icon.ico"
    }
  ],
 "mac": {
     "target": "dmg",
     "icon": "build/icon.png"
 },
 "linux": {
     "target": "AppImage",
     "category": "Utility",
     "maintainer": "Yan Huimin <yanhuimin434@gmail.com>",
     "icon": "build/icon.png"
 },
 "win": {
     "target": ["portable", "nsis"],
     "icon": "build/icon.ico"
 },
 "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
 }
}
