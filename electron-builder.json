{
 "appId": "com.yhm.bili",
 "productName": "BiliDownload",
 "files": [
    "dist-electron",
    "dist-react",
    "node_modules/ffmpeg-static/**/*"
],
  "asarUnpack": [
    "node_modules/ffmpeg-static/**"
  ],
 "icon": "./desktopIcon.png",
 "extraResources": [
    "dist-electron/preload.cjs",
    "src/assets/**",
    {
      "from": "src/ui/assets/icon.ico",
      "to": "icon.ico"
    }
  ],
 "mac": {
     "target": "dmg"
 },
 "linux": {
     "target": "APPImage",
     "category": "Utility",
     "maintainer": "Yan Huimin <yanhuimin434@gmail.com>"
 },
 "win": {
     "target": ["portable", "nsis"]
 },
 "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
 }
}
